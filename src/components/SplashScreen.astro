<!-- Pantalla de carga persistente (Splash Screen) -->
<div
	id="splash-screen"
	class="fixed inset-0 z-[100] bg-[#09090b] flex flex-col items-center justify-center transition-opacity duration-500 ease-out"
>
	<div class="relative flex items-center justify-center">
		<!-- Animación del Spinner circular -->
		<div
			class="h-40 w-40 rounded-full border-t-2 border-b-2 border-blue-500 animate-spin"
		>
		</div>
		<!-- Letra Logo central fija -->
		<div
			class="absolute text-blue-400 font-black text-lg select-none tracking-widest uppercase animate-pulse"
		>
			LogosAPP
		</div>
	</div>
	<p
		class="text-xs text-gray-500 uppercase tracking-[0.35em] mt-6 select-none animate-pulse"
	>
		Preparando lectura...
	</p>
</div>
