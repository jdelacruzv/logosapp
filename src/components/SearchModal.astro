---
const { currentVersion = "rv1960" } = Astro.props;
---

<div
	id="search-overlay"
	class="fixed inset-0 z-[60] bg-[#121212] hidden flex flex-col"
>
	<div class="flex items-center gap-3 p-4 border-b border-white/10">
		<button
			id="close-search"
			class="p-2 -ml-2 text-gray-400 hover:text-white hover:bg-white/5 rounded-full transition-all active:scale-90"
			aria-label="Volver"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="h-6 w-6"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M15 19l-7-7 7-7"></path>
			</svg>
		</button>
		<input
			type="text"
			id="search-input"
			placeholder="Buscar palabra o frase..."
			class="flex-1 bg-transparent text-white outline-none text-lg"
			autocomplete="off"
		/>
		<div
			id="search-loading"
			class="hidden animate-spin h-5 w-5 border-2 border-blue-500 border-t-transparent rounded-full"
		>
		</div>
	</div>

	<div id="search-results" class="flex-1 overflow-y-auto p-4 space-y-4">
		<p class="text-gray-500 text-center mt-10 text-sm">
			Empieza a escribir para buscar en {currentVersion.toUpperCase()}...
		</p>
	</div>
</div>

<script define:vars={{ currentVersion }}>
	const searchOverlay = document.getElementById("search-overlay");
	const searchInput = document.getElementById("search-input");
	const searchResults = document.getElementById("search-results");
	const loading = document.getElementById("search-loading");
	const closeBtn = document.getElementById("close-search");
	let debounceTimer;

	async function performSearch(query) {
		const cleanQuery = query.trim();
		if (cleanQuery.length < 3) {
			searchResults.innerHTML = `<p class="text-gray-500 text-center mt-10 text-sm italic">Escribe al menos 3 letras...</p>`;
			return;
		}

		loading.classList.remove("hidden");

		try {
			// Ajuste de URL según el estándar de tu API
			const res = await fetch(
				`https://logosapi.onrender.com/search/${currentVersion}?q=${encodeURIComponent(cleanQuery)}`,
			);

			if (!res.ok) throw new Error("Error en la respuesta");

			const data = await res.json();
			renderResults(data, cleanQuery);
		} catch (e) {
			searchResults.innerHTML = `<p class="text-red-400 text-center mt-10 text-sm">Error al conectar con el servidor.</p>`;
			console.error("Search Error:", e);
		} finally {
			loading.classList.add("hidden");
		}
	}

	function renderResults(data, query) {
		// Forzamos que data sea un array. Si la API lo envuelve en 'results', lo sacamos.
		const results = Array.isArray(data) ? data : data.results || [];

		if (results.length === 0) {
			searchResults.innerHTML = `
    		<div class="text-center mt-20 px-6">
    		  <p class="text-gray-400 text-lg mb-2">Sin resultados</p>
    		  <p class="text-gray-600 text-sm">
    		    Esta versión solo admite <span class="text-blue-400/60 font-bold">frases exactas</span>. 
    		    Intenta buscar palabras que aparezcan juntas (ej: "toda la tierra").
    		  </p>
    		</div>`;
			return;
		}

		searchResults.innerHTML = results
			.map((item) => {
				// Intentamos obtener los datos con diferentes nombres de propiedad por si acaso
				const b = item.book || item.book_name || "Libro";
				const c = item.chapter || 0;
				const v = item.verse || 0;
				// Aquí está el problema: asegúrate de usar la propiedad correcta para el texto
				const t = item.text || item.verse_text || item.content || "Sin contenido";

				const href = `/?version=${currentVersion}&book=${b.toLowerCase()}&chapter=${c}#v${v}`;

				return `
        <a href="${href}" 
           class="block p-4 bg-[#1a1a1a] border border-white/5 rounded-2xl hover:border-blue-500/30 transition-all active:scale-[0.98] group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-blue-400 text-[10px] font-bold uppercase tracking-[0.2em]">
              ${b} ${c}:${v}
            </span>
          </div>
          <p class="text-gray-300 text-sm leading-relaxed font-serif italic opacity-80 group-hover:opacity-100">
            "${t}"
          </p>
        </a>
      `;
			})
			.join("");
	}

	// Evento de escritura con Debounce
	searchInput?.addEventListener("input", (e) => {
		clearTimeout(debounceTimer);
		const query = e.target.value;
		debounceTimer = setTimeout(() => performSearch(query), 400);
	});

	// Cerrar buscador con la tecla ESC y limpiar contenido
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			// 1. Limpiamos el texto del input
			if (searchInput) searchInput.value = "";

			// 2. Limpiamos los resultados visuales para que no se vean al volver a entrar
			if (searchResults) {
				searchResults.innerHTML = `<p class="text-gray-500 text-center mt-10 text-sm italic">Escribe al menos 3 letras...</p>`;
			}

			// 3. Escondemos el buscador
			searchOverlay.classList.add("hidden");
		}
	});

	// Lógica del botón de cerrar (comportamiento similar a ESC)
	closeBtn?.addEventListener("click", () => {
		// Si hay texto en el input, primero lo limpiamos (volvemos "atrás" al estado inicial)
		if (searchInput.value.length > 0) {
			searchInput.value = "";
			searchResults.innerHTML = `<p class="text-gray-500 text-center mt-10 text-sm italic">Escribe al menos 3 letras...</p>`;
			searchInput.focus();
		} else {
			// Si el input ya está vacío, entonces cerramos el modal
			searchOverlay.classList.add("hidden");
		}
	});
</script>
