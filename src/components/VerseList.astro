---
import { normalizeVerses } from "../scripts/features/verseList.js";

const { verses = [], book = "genesis", chapter = 1 } = Astro.props;

const normalizedVerses = normalizeVerses(verses);
---

<article
  class="bible-text text-xl md:text-2xl font-serif leading-tight md:leading-relaxed space-y-4"
  style="color: var(--text);"
>
  {
    normalizedVerses.map((item) => (
      <div
        id={`v${item.verse}`}
        class="verse-paragraph block group transition-all p-1 -mx-1 rounded-lg"
        style="background: transparent;"
      >
        <button
          type="button"
          data-compare
          data-book={book}
          data-chapter={chapter}
          data-verse={item.verse}
          class="inline-block mr-2 font-bold transition-colors cursor-pointer font-sans text-[1em] align-baseline border-b border-transparent"
          style="color: var(--accent);"
        >
          {item.verse}
        </button>

        <span class="selection:bg-blue-500/30" style="color: var(--text);">
          {item.text}
        </span>
      </div>
    ))
  }
</article>
