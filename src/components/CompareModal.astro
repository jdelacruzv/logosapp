---

---

<div
  id="compare-overlay"
  class="fixed inset-0 z-[70] bg-[#09090b]/95 backdrop-blur-sm hidden flex flex-col"
>
	<!-- Header del Modal -->
  <div class="border-b border-white/10 bg-[#121212]">
    <div class="max-w-screen-md mx-auto flex items-center justify-between p-4">
      <div>
        <h3
          id="compare-title"
          class="text-blue-400 font-bold uppercase tracking-widest text-[10px]"
        >
          Comparar Versículo
        </h3>
        <p
          id="compare-subtitle"
          class="text-gray-500 text-[9px] uppercase tracking-tighter mt-0.5"
        >
          Múltiples versiones
        </p>
      </div>
      <button
        id="close-compare"
        class="text-gray-400 hover:text-white p-2 transition-transform active:scale-90"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto bg-[#121212]">
    <div class="max-w-screen-md mx-auto px-3 md:px-6 py-10">
      
      <div id="compare-content" class="space-y-6">
        <div
          id="compare-loader"
          class="flex flex-col items-center justify-center mt-20 gap-3"
        >
          <div
            class="animate-spin h-6 w-6 border-2 border-blue-500 border-t-transparent rounded-full"
          >
          </div>
          <p class="text-gray-500 text-[10px] tracking-[0.2em] uppercase">
            Buscando versiones...
          </p>
        </div>
        
        </div>

    </div>
  </div>
</div>

<script>
	interface Window {
		openCompare: (book: string, chapter: number, verse: number) => Promise<void>;
	}

	const overlay = document.getElementById("compare-overlay");
	const content = document.getElementById("compare-content");
	const loader = document.getElementById("compare-loader");
	const title = document.getElementById("compare-title");

	(window as any).openCompare = async (
		book: string,
		chapter: number,
		verse: number,
	) => {
		if (!overlay || !content || !loader || !title) return;

		overlay.classList.remove("hidden");
		document.body.style.overflow = "hidden";
		content.innerHTML = "";
		content.appendChild(loader);
		loader.classList.remove("hidden");

		title.innerText = `${book} ${chapter}:${verse}`;

		try {
			// Intentamos llamar a tu API interna
			// Usamos el nombre del libro tal cual viene
			const response = await fetch(
				`/api/compare?book=${encodeURIComponent(book)}&chapter=${chapter}&verse=${verse}`,
			);

			if (!response.ok) throw new Error("Error en el servidor local");

			const data = await response.json();
			loader.classList.add("hidden");

			// Si no hay datos, intentamos un segundo intento automático con el nombre normalizado (sin tildes)
			if (!data || data.length === 0) {
				const cleanBook = book.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
				const retryRes = await fetch(
					`/api/compare?book=${encodeURIComponent(cleanBook)}&chapter=${chapter}&verse=${verse}`,
				);
				const retryData = await retryRes.json();

				if (!retryData || retryData.length === 0) {
					content.innerHTML = `<div class="text-center mt-10"><p class="text-gray-500 text-sm">No se encontraron versiones para "${book}".</p></div>`;
					return;
				}
				renderVerses(retryData);
			} else {
				renderVerses(data);
			}
		} catch (e) {
			loader.classList.add("hidden");
			content.innerHTML = `<div class="text-center mt-10 text-red-400 text-xs uppercase tracking-widest">Error de sincronización</div>`;
		}
	};

	function renderVerses(data: any[]) {
		if (!content) return;
		content.innerHTML = data
			.map(
				(item: any) => `
			<div class="p-5 bg-white/[0.03] border border-white/5 rounded-3xl hover:bg-white/[0.06] transition-all group mb-4">
				<div class="flex justify-between items-center mb-3">
					<span class="text-[9px] font-black text-blue-400 uppercase tracking-widest bg-blue-500/10 px-2.5 py-1 rounded-full">
						${item.version_id || item.version_name || item.version || "VERSIÓN"}
					</span>
				</div>
				<p class="text-gray-300 text-[15px] leading-relaxed font-serif italic italic selection:bg-blue-500/30">
					"${item.text}"
				</p>
			</div>
		`,
			)
			.join("");
	}

	const closeCompare = () => {
		overlay?.classList.add("hidden");
		document.body.style.overflow = "auto";
	};

	document
		.getElementById("close-compare")
		?.addEventListener("click", closeCompare);
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && !overlay?.classList.contains("hidden"))
			closeCompare();
	});
</script>
