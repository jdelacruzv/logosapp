---
interface Props {
  version: string;
  book: string;
  chapter: number;
}

const { version, book, chapter } = Astro.props;
---

<header
  class="sticky top-0 z-50 backdrop-blur-md border-b"
  style={`background: var(--header-bg); border-color: var(--header-border);`}
>
  <div class="max-w-screen-md mx-auto px-4 h-16 flex items-center justify-between">
    <button
      id="btn-open-bible-navigator"
      class="flex flex-col sm:flex-row sm:items-center group gap-1 sm:gap-3 text-left cursor-pointer"
    >
      <span
        class="text-[16px] sm:text-xl font-bold tracking-widest uppercase leading-none"
        style="color: var(--accent);"
      >
        {version}
      </span>

      <span class="font-light leading-none hidden sm:block" style="color: var(--header-muted);">|</span>

      <div class="flex items-center gap-1 sm:gap-3 leading-none">
        <span
          class="text-[12px] sm:text-xs font-bold tracking-widest uppercase transition-colors"
          style="color: var(--header-text);"
        >
          {book}
        </span>
        <span class="font-light" style="color: var(--header-muted);">|</span>
        <span
          class="text-[12px] sm:text-xs font-bold tracking-widest uppercase"
          style="color: var(--header-text);"
        >
          Capítulo {chapter}
        </span>
        <span
          class="text-[8px] opacity-80 transition-opacity ml-1"
          style="color: var(--accent);"
        >
          ▼
        </span>
      </div>
    </button>

    <div class="flex items-center gap-2">
      <button
        id="btn-open-search"
        class="p-2 rounded-full transition-all cursor-pointer flex items-center justify-center"
        style="background: transparent;"
        aria-label="Buscar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 transition-colors"
          style="color: var(--header-muted);"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          ></path>
        </svg>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="p-2 rounded-full transition-all cursor-pointer flex items-center justify-center"
        aria-label="Cambiar tema"
        title="Cambiar tema"
        style="background: transparent;"
      >
        <svg
          id="theme-icon-sun"
          class="h-5 w-5 transition-colors"
          style="color: var(--header-muted);"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2.2M12 19.3v2.2M4.93 4.93l1.56 1.56M17.51 17.51l1.56 1.56M2.5 12h2.2M19.3 12h2.2M4.93 19.07l1.56-1.56M17.51 6.49l1.56-1.56"></path>
        </svg>

        <svg
          id="theme-icon-moon"
          class="hidden h-5 w-5 transition-colors"
          style="color: var(--header-muted);"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path d="M21 12.8A8.8 8.8 0 0 1 11.2 3a8.8 8.8 0 1 0 9.8 9.8Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
