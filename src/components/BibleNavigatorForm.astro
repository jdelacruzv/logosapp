---
const { currentVersion = "rv1960", currentBook = "genesis", currentChapter = "1" } = Astro.props;
---

<div
  id="bible-selector-container"
  data-version={currentVersion}
  data-book={currentBook}
  data-chapter={currentChapter}
  class="bible-selector-container flex flex-col gap-4 p-6 rounded-t-3xl"
>
  <div class="flex justify-between items-center mb-2">
    <h2 class="text-xl font-bold text-[var(--text-strong)]">Navegación</h2>
    <button id="close-selector-btn" type="button" class="bible-nav-close-btn p-2 cursor-pointer">
      ✕
    </button>
  </div>

  <div class="flex flex-col gap-4">
    <div class="flex flex-col gap-1">
      <label class="bible-control-label text-[10px] font-bold uppercase ml-1">Versión</label>
      <select id="version-select" class="bible-control-field appearance-none">
        <option value={currentVersion}>{currentVersion.toUpperCase()}</option>
      </select>
    </div>
  </div>

  <div class="flex flex-col gap-1">
    <label class="bible-control-label text-[10px] font-bold uppercase ml-1">Filtrar</label>
    <select id="book-filter-select" class="bible-control-field appearance-none">
      <option value="Todos">Todos</option>
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label class="bible-control-label text-[10px] font-bold uppercase ml-1">Libro</label>
    <select id="book-select" class="bible-control-field appearance-none">
      <option value={currentBook}>{currentBook}</option>
    </select>
  </div>

  <div class="flex gap-3 mt-2">
    <div class="w-1/2">
      <label class="bible-control-label text-[10px] font-bold uppercase ml-1"> Capítulo </label>
      <input
        type="number"
        id="chapter-input"
        value={currentChapter}
        min="1"
        class="bible-control-field h-[58px]"
      />
    </div>

    <div class="w-1/2 flex items-end">
      <button
        id="go-btn"
        type="button"
        class="w-full h-[58px] bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 active:scale-95 transition-all cursor-pointer"
      >
        LEER
      </button>
    </div>
  </div>
</div>
