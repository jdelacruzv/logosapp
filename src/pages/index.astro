---
import Layout from "../layouts/Layout.astro";
import BibleSelector from "../components/BibleSelector.astro";
import SearchModal from "../components/SearchModal.astro";
import CompareModal from "../components/CompareModal.astro";

const url = new URL(Astro.request.url);
// Aseguramos que los valores sean minúsculas para la API
const version = (url.searchParams.get("version") || "rv1960").toLowerCase();
const book = (url.searchParams.get("book") || "genesis").toLowerCase();
const capitalizedBook = book.charAt(0).toUpperCase() + book.slice(1);

// Forzamos la conversión a número y usamos un fallback de 1
const chapterParam = url.searchParams.get("chapter") || "1";
const chapter = parseInt(chapterParam, 10) || 1;

// Ahora chapter es de tipo 'number', y las operaciones funcionarán:
const prevChapter = chapter > 1 ? chapter - 1 : null;
const nextChapter = chapter + 1;

// Función para capitalizar el nombre del libro (ej: "genesis" -> "Génesis")
const displayBook = book.charAt(0).toUpperCase() + book.slice(1);

let verses = [];
let errorMsg = "";

try {
	const apiUrl = `https://logosapi.onrender.com/read/${version}/${book}/${chapter}`;
	console.log("Pidiendo texto a:", apiUrl);

	const response = await fetch(apiUrl);

	if (!response.ok) {
		errorMsg = `Error ${response.status}: No se encontró el contenido.`;
	} else {
		const data = await response.json();

		// REVISIÓN DE ESTRUCTURA:
		// Tu API puede devolver los versículos en 'results', 'verses' o directo en la raíz
		verses = data.results || data.verses || (Array.isArray(data) ? data : []);

		if (verses.length === 0) {
			console.log("JSON recibido pero vacío:", data);
		}
	}
} catch (e) {
	errorMsg = "Error de conexión. Revisa si la API en Render está activa.";
}
---

<Layout title={`LogosApp | ${book} ${chapter}`}>
	<!-- Splash LogosAPP -->
	<!-- <div
		id="splash-screen"
		class="fixed inset-0 z-[200] bg-[#0c0c0e] flex flex-col items-center justify-center transition-opacity duration-700"
	>
		<div class="relative">
			<div
				class="text-4xl font-black text-blue-500 tracking-tighter mb-4 animate-pulse"
			>
				LogosAPP
			</div>
			<div class="absolute -bottom-8 left-1/2 -translate-x-1/2 flex gap-1">
				<div class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-bounce"></div>
				<div
					class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-bounce [animation-delay:0.2s]"
				>
				</div>
				<div
					class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-bounce [animation-delay:0.4s]"
				>
				</div>
			</div>
		</div>
		<p
			class="mt-12 text-[10px] uppercase tracking-[0.3em] text-gray-500 animate-in fade-in duration-1000"
		>
			Sincronizando con el servidor...
		</p>
	</div> -->

	<div
		id="splash-screen"
		class="fixed inset-0 z-[200] bg-[#0c0c0e] flex flex-col items-center justify-center transition-all duration-1000"
	>
		<div class="text-center animate-in fade-in zoom-in duration-700">
			<h1 class="text-5xl font-black text-blue-500 tracking-tighter">LogosAPP</h1>
			<div class="mt-8 flex justify-center gap-2">
				<div
					class="w-2 h-2 bg-blue-500 rounded-full animate-bounce [animation-delay:-0.3s]"
				>
				</div>
				<div
					class="w-2 h-2 bg-blue-500 rounded-full animate-bounce [animation-delay:-0.15s]"
				>
				</div>
				<div class="w-2 h-2 bg-blue-500 rounded-full animate-bounce"></div>
			</div>
			<p
				id="splash-text"
				class="mt-10 text-[10px] uppercase tracking-[0.4em] text-gray-500"
			>
				Sincronizando con el servidor...
			</p>
		</div>
	</div>

	<!-- Overlay del Selector -->
	<div
		id="selector-overlay"
		class="fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm hidden flex items-end justify-center transition-all"
	>
		<div class="w-full max-w-screen-md animate-slide-up">
			<BibleSelector
				currentVersion={version}
				currentBook={book}
				currentChapter={chapter}
			/>
		</div>
	</div>

	<!-- Header -->
	<header
		class="sticky top-0 z-50 bg-[#121212]/90 backdrop-blur-md border-b border-gray-800"
	>
		<div
			class="max-w-screen-md mx-auto px-4 h-16 flex items-center justify-between"
		>
			<button
				id="open-selector"
				class="flex items-center group gap-2 sm:gap-3 text-left cursor-pointer"
			>
				<span
					class="text-[10px] sm:text-xs font-bold tracking-widest text-blue-400 uppercase leading-none"
				>
					{version}
				</span>
				<span class="text-gray-600 font-light leading-none">|</span>
				<span
					class="text-[10px] sm:text-xs font-bold tracking-widest text-white/60 uppercase group-hover:text-white transition-colors leading-none"
				>
					{book}
				</span>
				<span class="text-gray-600 font-light leading-none">|</span>
				<span
					class="text-[10px] sm:text-xs font-bold tracking-widest text-white/60 uppercase leading-none"
				>
					Capítulo {chapter}
				</span>
				<span
					class="text-[8px] text-blue-400 opacity-50 group-hover:opacity-100 transition-opacity ml-1"
				>
					▼
				</span>
			</button>

			<button
				id="trigger-search"
				class="p-2 hover:bg-white/5 rounded-full transition-all cursor-pointer flex items-center justify-center"
				aria-label="Buscar"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-5 w-5 text-gray-400 hover:text-blue-400 transition-colors"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</button>
		</div>
	</header>

	<!-- Contenido Principal -->
	<main class="max-w-screen-md mx-auto px-3 md:px-6 py-5">
		{
			errorMsg && (
				<div class="p-4 mb-6 bg-red-500/10 border border-red-500/20 text-red-500 rounded-xl text-center">
					{errorMsg}
				</div>
			)
		}

		<!-- Texto del Bible -->
		<article
			class="bible-text text-xl md:text-2xl font-serif leading-tight md:leading-relaxed text-gray-200 space-y-4"
		>
			{
				verses.map((v: any) => (
					<div
						id={`v${v.verse}`}
						class="verse-paragraph block group transition-all p-1 -mx-1 rounded-lg hover:bg-white/[0.02]"
					>
						<button
							onclick={`openCompare('${book}', ${chapter}, ${v.verse})`}
							class="inline-block mr-2 text-blue-500/60 font-bold hover:text-blue-400 transition-colors cursor-pointer font-sans text-[1em] align-baseline border-b border-transparent hover:border-blue-400/30"
						>
							{v.verse}
						</button>

						<span class="text-gray-300 selection:bg-blue-500/30">{v.text}</span>
					</div>
				))
			}
		</article>

		<!-- Paginación integrada al final del texto -->
		<nav class="mt-8 pt-6 border-t border-white/10">
			<div class="flex flex-row justify-between items-center gap-2">
				{
					prevChapter ? (
						<a
							href={`/?version=${version}&book=${book}&chapter=${prevChapter}`}
							class="inline-flex items-center gap-1 bg-[#1a1a1a] border border-white/10 text-white px-5 py-4 rounded-full text-[14px] font-sans font-medium hover:bg-[#222] transition-all active:scale-95 cursor-pointer group h-fit"
						>
							<span class="text-blue-400 font-bold text-xs leading-none group-hover:-translate-x-0.5 transition-transform">
								←
							</span>
							<span class="opacity-70 group-hover:opacity-100 leading-none">
								Capítulo {prevChapter}
							</span>
						</a>
					) : (
						<div />
					)
				}

				<a
					href={`/?version=${version}&book=${book}&chapter=${nextChapter}`}
					class="inline-flex items-center gap-1 bg-[#1a1a1a] border border-white/10 text-white px-6 py-4 rounded-full text-[14px] font-sans font-medium hover:bg-[#222] transition-all active:scale-95 cursor-pointer group h-fit"
				>
					<span class="opacity-70 group-hover:opacity-100 leading-none">
						Capítulo {nextChapter}
					</span>
					<span
						class="text-blue-400 font-bold text-xs leading-none group-hover:translate-x-0.5 transition-transform"
					>
						→
					</span>
				</a>
			</div>
		</nav>

		<SearchModal currentVersion={version} />
		<CompareModal />
	</main>

	<style>
		.animate-slide-up {
			animation: slideUp 0.3s cubic-bezier(0, 0.55, 0.45, 1);
		}
		@keyframes slideUp {
			from {
				transform: translateY(100%);
			}
			to {
				transform: translateY(0);
			}
		}
	</style>

	<script>
		// Lógica simplificada: Solo apertura del selector
		const splash = document.getElementById("splash-screen");
		const openBtn = document.getElementById("open-selector");
		const overlay = document.getElementById("selector-overlay");

		const initApp = () => {
			openBtn?.addEventListener("click", () => {
				overlay?.classList.remove("hidden");
			});
			// Cerrar al hacer clic fuera del contenido del selector
			overlay?.addEventListener("click", (e) => {
				if (e.target === overlay) {
					overlay.classList.add("hidden");
				}
			});
		};
		initApp();
		// Soporte para navegación de Astro
		document.addEventListener("astro:after-swap", initApp);
		// Función para abrir el buscador
		const btnSearch = document.getElementById("trigger-search");
		const searchOverlay = document.getElementById("search-overlay");
		const searchInput = document.getElementById("search-input");
		btnSearch?.addEventListener("click", () => {
			// Quitamos hidden para mostrarlo
			searchOverlay?.classList.remove("hidden");
			// Ponemos el foco en el input automáticamente para escribir rápido
			searchInput?.focus();
		});
		// Lógica de resaltado de versículos
		function highlightVerse() {
			// Obtenemos el ID desde la URL (ej: #v12)
			const hash = window.location.hash;
			if (hash && hash.startsWith("#v")) {
				const verseElement = document.querySelector(hash);
				if (verseElement) {
					// Limpiamos resaltados previos si existen
					document.querySelectorAll(".verse-paragraph").forEach((p) => {
						p.classList.remove("bg-blue-500/20", "ring-1", "ring-blue-500/30");
					});
					// Aplicamos el resaltado al versículo seleccionado
					verseElement.classList.add("bg-blue-500/20", "ring-1", "ring-blue-500/30");
					// Scroll suave hacia el versículo
					verseElement.scrollIntoView({ behavior: "smooth", block: "center" });
					// Opcional: Quitar el resaltado después de unos segundos
					setTimeout(() => {
						verseElement.classList.remove(
							"bg-blue-500/20",
							"ring-1",
							"ring-blue-500/30",
						);
					}, 5000);
				}
			}
		}
		// Ejecutar cuando carga la página
		window.addEventListener("load", highlightVerse);
		// Ejecutar si el hash cambia sin recargar la página (navegación interna)
		window.addEventListener("hashchange", highlightVerse);

		// 1. PERSISTENCIA: Guardar donde se quedó el usuario
		function saveCurrentLocation() {
			const params = new URLSearchParams(window.location.search);
			const data = {
				version: params.get("version") || "rv1960",
				book: params.get("book") || "genesis",
				chapter: params.get("chapter") || "1",
			};
			localStorage.setItem("last_bible_read", JSON.stringify(data));
		}

		// 2. REDIRECCIÓN: Si entra al home puro (/), llevarlo a la última lectura
		function redirectToLastRead() {
			const lastRead = localStorage.getItem("last_bible_read");
			const params = new URLSearchParams(window.location.search);

			// Solo redirigir si no hay parámetros en la URL (primera entrada)
			if (!params.has("book") && lastRead) {
				const { version, book, chapter } = JSON.parse(lastRead);
				window.location.href = `/?version=${version}&book=${book}&chapter=${chapter}`;
			} else {
				// Si ya está en la página correcta, ocultar splash tras un breve delay
				// para dar tiempo a que los componentes terminen de "despertar"
				setTimeout(() => {
					if (splash) {
						splash.classList.add("opacity-0", "pointer-events-none");
					}
				}, 800);
			}
		}

		// Ejecutar al cargar
		window.addEventListener("load", () => {
			redirectToLastRead();
			saveCurrentLocation();
		});

		// Guardar ubicación cada vez que el usuario use el selector (opcional)
		document.addEventListener("astro:after-swap", saveCurrentLocation);
	</script>
</Layout>
