---
import Layout from "../layouts/Layout.astro";
import SearchModal from "../components/SearchModal.astro";
import CompareModal from "../components/CompareModal.astro";
import Header from "../components/Header.astro";
import SplashScreen from "../components/SplashScreen.astro";
import BibleNavigator from "../components/BibleNavigator.astro";
import Pagination from "../components/Pagination.astro";
import VerseList from "../components/VerseList.astro";

import { formatBookNameForApi, getBookChapterCount } from "../utils/bible_chapters.js";
import { getChapter } from "../services/bibleApi.js";

const url = new URL(Astro.request.url);

// Normalizamos el nombre del libro para usar el identificador esperado por la API.
const version = (url.searchParams.get("version") || "rv1960").toLowerCase();
const bookName = url.searchParams.get("book") || "genesis";
const book = bookName.toLowerCase();
const apiBook = formatBookNameForApi(book);

const capitalizedBook = bookName.charAt(0).toUpperCase() + bookName.slice(1);

const maxChapters = getBookChapterCount(book);

// Validamos también los capítulos recibidos directamente por la URL.
const chapterParam = url.searchParams.get("chapter") || "1";
const requestedChapter = Number(chapterParam);
const validChapter = Number.isInteger(requestedChapter) ? requestedChapter : 1;
const chapter = Math.min(Math.max(validChapter, 1), maxChapters);

if (chapterParam !== String(chapter)) {
  url.searchParams.set("chapter", String(chapter));
  return Astro.redirect(`${url.pathname}${url.search}`, 302);
}

// Ahora chapter es de tipo 'number', y las operaciones funcionarán:
const prevChapter = chapter > 1 ? chapter - 1 : null;
const nextChapter = chapter < maxChapters ? chapter + 1 : null;

// Obtenemos los versículos del capítulo actual
let verses = [];
let errorMsg = "";

try {
  verses = await getChapter(version, apiBook, chapter);

  if (verses.length === 0) {
    console.log("El capítulo no contiene versículos.");
  }
} catch (error) {
  console.error("Error al cargar el capítulo:", error);
  errorMsg = "Error de conexión. Revisa si la API está activa.";
}
---

<Layout title={`LogosApp | ${book} ${chapter}`}>
  <!-- Restaurar y guardar última posición de lectura -->
  <script>
    import { getLastPosition, saveLastPosition } from "../lib/lastPosition.js";

    function restoreLastPosition() {
      const url = new URL(window.location.href);

      const hasPosition =
        url.searchParams.has("version") ||
        url.searchParams.has("book") ||
        url.searchParams.has("chapter");

      // Si ya existe una posición en la URL,
      // esa posición tiene prioridad y se guarda.
      if (hasPosition) {
        const version = url.searchParams.get("version");
        const book = url.searchParams.get("book");
        const chapter = url.searchParams.get("chapter");

        if (version && book && chapter) {
          saveLastPosition(version, book, chapter);
        }

        return;
      }

      // Si no hay posición en la URL,
      // intentamos recuperar la última posición.
      const lastPosition = getLastPosition();

      if (!lastPosition) {
        return;
      }

      const params = new URLSearchParams({
        version: lastPosition.version,
        book: lastPosition.book,
        chapter: String(lastPosition.chapter),
      });

      window.location.replace(`/?${params.toString()}`);
    }

    restoreLastPosition();
  </script>

  <!-- Splash screen LogosAPP -->
  <SplashScreen />

  <!-- Selector overlay -->
  <BibleNavigator version={version} book={bookName} chapter={chapter} />

  <!-- Header -->
  <Header version={version} book={capitalizedBook} chapter={chapter} />

  <!-- Main content -->
  <main class="max-w-screen-md mx-auto px-3 md:px-6 py-5">
    {
      errorMsg && (
        <div class="p-4 mb-6 bg-red-500/10 border border-red-500/20 text-red-500 rounded-xl text-center">
          {errorMsg}
        </div>
      )
    }

    <!-- Bible text -->
    <VerseList verses={verses} book={book} chapter={chapter} />

    <!-- Paginación integrada al final del texto -->
    <Pagination version={version} book={book} prevChapter={prevChapter} nextChapter={nextChapter} />

    <!-- Search modal -->
    <SearchModal currentVersion={version} />

    <!-- Comparison Modal -->
    <CompareModal />
  </main>

  <script>
    // Inicializa la aplicación y dispara el evento "logos:init" para ocultar el splash screen
    function initApp() {
      document.dispatchEvent(new Event("logos:init"));
    }

    initApp();

    // Asegura que la inicialización se ejecute después de cada swap de Astro (cuando se navega a otra página)
    document.addEventListener("astro:after-swap", initApp);
  </script>
</Layout>
